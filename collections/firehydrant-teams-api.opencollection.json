          "docs": "Create a team"
        },
        {
          "info": {
            "name": "Retrieve a team",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.firehydrant.io/v1/teams/:team_id",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path"
              }

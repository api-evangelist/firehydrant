{
  "opencollection": "1.0.0",
  "info": {
    "name": "FireHydrant REST Audits Runbooks API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Runbooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List runbooks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.firehydrant.io/v1/runbooks"
          },
          "docs": "List runbooks"
        },
        {
          "info": {
            "name": "Create a runbook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.firehydrant.io/v1/runbooks",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a runbook"
        },
        {
          "info": {
            "name": "Execute a runbook against a target",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.firehydrant.io/v1/runbooks/executions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Execute a runbook against a target"
        }
      ]
    }
  ],
  "bundled": true
}